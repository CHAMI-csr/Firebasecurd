<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border_color" />

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_alert"
            app:tint="@color/status_out_of_stock"
            android:contentDescription="Alerts" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sheet_alerts_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_poppins"
                android:text="Stock Alerts &amp; Re-stock"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sheet_alerts_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_poppins"
                android:text="3 items require immediate restocking"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_sheet_alerts_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_muted"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Filter Chips for Alerts -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_sheet_alerts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_alert_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/font_poppins"
                android:text="All Alerts"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_alert_out"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_poppins"
                android:text="Out of Stock"
                android:textColor="@color/status_out_of_stock"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_alert_low"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_poppins"
                android:text="Low Stock"
                android:textColor="@color/status_low_stock"
                android:textSize="12sp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/border_color" />

    <!-- RecyclerView of Alert Products -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sheet_alerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:nestedScrollingEnabled="true" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_sheet_alerts_empty"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_check"
            app:tint="@color/status_in_stock"
            android:contentDescription="All Good" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/font_poppins"
            android:text="Inventory is in Great Shape! 🎉"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/font_poppins"
            android:text="No products are currently low or out of stock"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Actions: Export Supplier Order Sheet -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_export_reorder_pdf"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/status_out_of_stock"
            android:fontFamily="@font/font_poppins"
            android:text="📄 Export Reorder Sheet (PDF)"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
