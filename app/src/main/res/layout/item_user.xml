<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- User Avatar Circle -->
        <FrameLayout
            android:id="@+id/fl_user_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_neutral">

            <TextView
                android:id="@+id/tv_avatar_initial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="A"
                android:textColor="@color/accent_blue"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- User Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_fullname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Administrator"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_user_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="\@admin"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Role Badge -->
        <TextView
            android:id="@+id/tv_user_role_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_badge_in_stock"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:maxLines="1"
            android:text="ADMIN"
            android:textColor="@color/status_in_stock"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Activity Log Button -->
        <ImageButton
            android:id="@+id/btn_user_activity"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_history"
            app:tint="@color/accent_blue"
            android:contentDescription="View user activity" />

        <!-- Edit Button -->
        <ImageButton
            android:id="@+id/btn_edit_user"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_edit"
            app:tint="@color/accent_blue"
            android:contentDescription="Edit user" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btn_delete_user"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/status_out_of_stock"
            android:contentDescription="Delete user" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
